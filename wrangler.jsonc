{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thirupathi-painting",
  "compatibility_date": "2026-10-06",
  // Static site: serve /dist, and fall back to index.html for client-side routes
  // (/services, /works, /contact). Do not add a _redirects file — Workers rejects
  // the SPA rewrite rule as an infinite loop; this setting replaces it.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
